<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Saving chapters runs in the foreground with a progress notification, so a long queue is not cut off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Voice control in the reader. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- TTS narration keeps playing with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Android TV: leanback launcher entry for TvActivity. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".DexterApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Dexter"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="mangadex.org" />
                <data android:host="www.mangadex.org" />
                <data android:pathPrefix="/title/" />
                <data android:pathPrefix="/manga/" />
                <data android:pathPrefix="/chapter/" />
            </intent-filter>
            <!-- AniList and MyAnimeList return here after you sign in. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dexter" />
                <data android:host="anilist" />
                <data android:host="mal" />
            </intent-filter>
            <!-- Google Drive and Dropbox return here after OAuth sign-in. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dexter" />
                <data android:host="oauth" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <receiver
            android:name=".notify.MarkReadReceiver"
            android:exported="false" />
        <receiver
            android:name=".notify.DownloadActionReceiver"
            android:exported="false" />
        <!-- Shares a saved or copied page image with other apps, read-only, one file at a time. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- WorkManager's foreground service, declared as a data sync so the download worker may use it. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <!-- Chromecast: the Cast SDK reads the OptionsProvider class from this entry at startup. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.dexter.cast.DexterCastOptionsProvider" />
        <receiver
            android:name=".notify.ContinueWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/continue_widget_info" />
        </receiver>
        <receiver
            android:name=".notify.UpdatesWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/updates_widget_info" />
        </receiver>
        <!-- Quick Settings tiles: continue reading and check for updates. -->
        <service
            android:name=".platform.ContinueReadingTile"
            android:label="Continue reading"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".platform.CheckUpdatesTile"
            android:label="Check for updates"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- TTS narration with the screen off. -->
        <service
            android:name=".tts.ReaderTtsService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
        <!-- Tasker / automation intents. -->
        <receiver
            android:name=".automation.AutomationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dexter.automation.LIBRARY_UPDATE" />
                <action android:name="com.dexter.automation.OPEN_CONTINUE_READING" />
                <action android:name="com.dexter.automation.OPEN_READER" />
            </intent-filter>
        </receiver>
        <!-- Wear OS companion: answers progress requests from the watch. -->
        <service
            android:name=".platform.WearMessageReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" />
            </intent-filter>
        </service>
        <!-- Android TV entry point. -->
        <activity
            android:name=".ui.tv.TvActivity"
            android:exported="true"
            android:theme="@style/Theme.Dexter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
